@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Copies the TSVD4J analysis sources into flakesync-core so that the agent can
+# dispatch to them under agentmode=TSV_DETECTION.
+#
+# Usage: bash integrate-tsvd4j.sh /path/to/TSVD4J
+set -euo pipefail
+
+TSVD4J_HOME="${1:?usage: integrate-tsvd4j.sh /path/to/TSVD4J}"
+CORE_JAVA="flakesync-core/src/main/java/edu/utexas/ece"
+CORE_RES="flakesync-core/src/main/resources"
+
+if [ ! -d "$TSVD4J_HOME/tsvd4j-core" ]; then
+  echo "error: $TSVD4J_HOME does not look like a TSVD4J checkout" >&2
+  exit 1
+fi
+
+mkdir -p "$CORE_JAVA"
+cp -r "$TSVD4J_HOME/tsvd4j-core/src/main/java/edu/utexas/ece/tsvd4j" "$CORE_JAVA/"
+cp "$TSVD4J_HOME/tsvd4j-core/src/main/resources/API.txt" "$CORE_RES/"
+cp "$TSVD4J_HOME/tsvd4j-core/src/main/resources/allAPI.txt" "$CORE_RES/"
+
+# The TestListener depends on JUnit, which flakesync-core does not declare.
+# We collect results from the agent shutdown hook instead, so drop it.
+rm -rf "$CORE_JAVA/tsvd4j/listener"
+
+# Sanity check: the agent must never instrument its own analysis classes.
+if ! grep -q '^edu\.utexas\.ece\.tsvd4j$' "$CORE_RES/blacklist.txt"; then
+  echo "error: blacklist.txt is missing 'edu.utexas.ece.tsvd4j'" >&2
+  echo "       add it before building, or the Proxy will recurse into itself" >&2
+  exit 1
+fi
+
+echo "Copied TSVD4J sources into flakesync-core."
+find "$CORE_JAVA/tsvd4j" -name '*.java' | sort
