+
+package flakesync;
+
+import flakesync.common.Level;
+import flakesync.common.Logger;
+
+import org.apache.maven.plugin.MojoExecutionException;
+import org.apache.maven.plugin.MojoFailureException;
+import org.apache.maven.plugins.annotations.LifecyclePhase;
+import org.apache.maven.plugins.annotations.Mojo;
+import org.apache.maven.plugins.annotations.Parameter;
+import org.apache.maven.plugins.annotations.ResolutionScope;
+
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileWriter;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+/**
+ * Runs TSVD4J's thread-safety-violation analysis, optionally restricted to the
+ * region FlakeSync localized for the given test.
+ *
+ * <p>Each run writes .flakesync/Results-TSV/&lt;test&gt;-TSV-run&lt;N&gt;.csv;
+ * this mojo additionally writes a manifest describing the configuration so that
+ * runs can be aggregated afterwards.
+ */
+@Mojo(name = "tsvdetect", defaultPhase = LifecyclePhase.TEST,
+        requiresDependencyResolution = ResolutionScope.TEST)
+public class TsvDetectMojo extends FlakeSyncAbstractMojo {
+
+    /** How many times to repeat the (randomized) TSVD4J run. */
+    @Parameter(property = "flakesync.tsvRuns", defaultValue = "10")
+    protected int tsvRuns;
+
+    /**
+     * Scope file. Defaults to the minimized locations for this test. Pass
+     * -Dflakesync.tsvScope=NONE to run whole-program TSVD4J (the C1 baseline).
+     */
+    @Parameter(property = "flakesync.tsvScope", defaultValue = "")
+    protected String tsvScope;
+
+    /** One of: field, api, both. */
+    @Parameter(property = "flakesync.tsvKind", defaultValue = "both")
+    protected String tsvKind;
+
+    /** Delay in ms handed to the agent; 0 means no FlakeSync delay injection. */
+    @Parameter(property = "flakesync.tsvDelay", defaultValue = "0")
+    protected int tsvDelay;
+
+    /**
+     * When set, delays are injected at these locations while TSV analysis runs
+     * (condition T1). Usually the minimized locations file.
+     */
+    @Parameter(property = "flakesync.tsvDelayLocs", defaultValue = "")
+    protected String tsvDelayLocs;
+
+    @Override
+    public void execute() throws MojoExecutionException, MojoFailureException {
+        super.execute();
+
+        String scopeFile = resolveScopeFile();
+        long suiteStart = System.currentTimeMillis();
+        int failures = 0;
+
+        Path manifest = Paths.get(this.baseDir.toString(), Constants.DEFAULT_FLAKESYNC_DIR,
+                "Results-TSV", this.testName.replace("#", ".") + "-manifest.csv");
+        manifest.getParent().toFile().mkdirs();
+
+        BufferedWriter mf = null;
+        try {
+            mf = new BufferedWriter(new FileWriter(manifest.toFile()));
+            mf.write("run,scope,kind,delay,delayLocs,wallClockMs,testOutcome");
+            mf.newLine();
+
+            for (int run = 0; run < this.tsvRuns; run++) {
+                long start = System.currentTimeMillis();
+                String outcome = "PASS";
+                try {
+                    SurefireExecution.SurefireFactory.createTsvDetectionExec(
+                            this.surefire, this.originalArgLine, this.mavenProject, this.mavenSession,
+                            this.pluginManager, Constants.DEFAULT_FLAKESYNC_DIR, this.localRepository,
+                            this.testName, this.tsvDelay, scopeFile, this.tsvKind, run,
+                            this.tsvDelayLocs).run();
+                } catch (Throwable tr) {
+                    // A failing test is a legitimate observation here, not an error.
+                    outcome = "FAIL";
+                    failures++;
+                    Logger.getGlobal().log(Level.INFO, "Run " + run + " ended with a test failure");
+                }
+                long elapsed = System.currentTimeMillis() - start;
+                mf.write(run + "," + (scopeFile == null ? "WHOLE_PROGRAM" : scopeFile) + ","
+                        + this.tsvKind + "," + this.tsvDelay + ","
+                        + (this.tsvDelayLocs == null || this.tsvDelayLocs.isEmpty() ? "none" : this.tsvDelayLocs)
+                        + "," + elapsed + "," + outcome);
+                mf.newLine();
+                mf.flush();
+                Logger.getGlobal().log(Level.INFO, "TSV run " + run + " finished in " + elapsed + " ms ("
+                        + outcome + ")");
+            }
+        } catch (Exception ex) {
+            throw new MojoExecutionException("Failed while running TSV detection", ex);
+        } finally {
+            if (mf != null) {
+                try {
+                    mf.close();
+                } catch (Exception ignored) {
+                    // Nothing useful to do here.
+                }
+            }
+        }
+
+        long total = System.currentTimeMillis() - suiteStart;
+        Logger.getGlobal().log(Level.INFO, "TSV detection: " + this.tsvRuns + " runs, "
+                + failures + " test failures, " + total + " ms total. Manifest: " + manifest);
+    }
+
+    /** Returns null for whole-program analysis, otherwise a path to a scope file. */
+    private String resolveScopeFile() throws MojoExecutionException {
+        if ("NONE".equalsIgnoreCase(this.tsvScope)) {
+            Logger.getGlobal().log(Level.INFO, "Running whole-program TSVD4J (no scope)");
+            return null;
+        }
+        String path = this.tsvScope;
+        if (path == null || path.isEmpty()) {
+            path = String.valueOf(Constants.getMinLocationsFilepath(this.testName));
+        }
+        File file = new File(path);
+        if (!file.exists()) {
+            throw new MojoExecutionException("Scope file does not exist: " + path
+                    + " -- run the deltadebug goal first, or pass -Dflakesync.tsvScope=NONE");
+        }
+        Logger.getGlobal().log(Level.INFO, "Scoping TSV analysis to " + path);
+        return file.getAbsolutePath();
+    }
+}
