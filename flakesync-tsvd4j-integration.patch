index 0000000..d0610cb
--- /dev/null
+++ b/tools/aggregate_tsv.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""Aggregate FlakeSync/TSVD4J runs into per-condition pair sets and set differences.
+
+Layout expected (one directory per condition):
+
+    results/<subject>/<condition>/Results-TSV/<test>-TSV-run<N>.csv
+    results/<subject>/<condition>/Results-TSV/<test>-manifest.csv
+
+Usage:
+    python3 tools/aggregate_tsv.py results/uniffle-grpc
+    python3 tools/aggregate_tsv.py results/uniffle-grpc --classify T1 T2
+"""
+
+import argparse
+import csv
+import pathlib
+import statistics
+import sys
+
+
+def read_pairs(path):
+    """Returns the set of conflicting pairs in one run file."""
+    pairs = set()
+    with open(path, newline="") as fh:
+        for line in fh:
+            line = line.strip()
+            if not line or line.startswith("#") or line.startswith("pointA"):
+                continue
+            pairs.add(line)
+    return pairs
+
+
+def read_meta(path):
+    """Returns the #key=value header lines of one run file."""
+    meta = {}
+    with open(path) as fh:
+        for line in fh:
+            if not line.startswith("#"):
+                break
+            if "=" in line:
+                key, _, value = line[1:].strip().partition("=")
+                meta[key] = value
+    return meta
+
+
+def load_condition(cond_dir):
+    tsv_dir = cond_dir / "Results-TSV"
+    if not tsv_dir.is_dir():
+        return None
+
+    runs = sorted(tsv_dir.glob("*-TSV-run*.csv"),
+                  key=lambda p: int(p.stem.rsplit("run", 1)[1]))
+    if not runs:
+        return None
+
+    per_run = [read_pairs(p) for p in runs]
+    union = set().union(*per_run) if per_run else set()
+    meta = read_meta(runs[0])
+
+    times, outcomes = [], []
+    manifests = list(tsv_dir.glob("*-manifest.csv"))
+    if manifests:
+        with open(manifests[0], newline="") as fh:
+            for row in csv.DictReader(fh):
+                times.append(int(row["wallClockMs"]))
+                outcomes.append(row["testOutcome"])
+
+    return {
+        "name": cond_dir.name,
+        "runs": len(per_run),
+        "per_run": per_run,
+        "union": union,
+        "scope_size": meta.get("scopeSize", "?"),
+        "instrumented": meta.get("classesInstrumented", "?"),
+        "considered": meta.get("classesConsidered", "?"),
+        "times": times,
+        "fail_rate": (outcomes.count("FAIL") / len(outcomes)) if outcomes else None,
+    }
+
+
+def saturation(per_run):
+    """Cumulative unique-pair count after each run -- checks whether N was enough."""
+    seen, curve = set(), []
+    for pairs in per_run:
+        seen |= pairs
+        curve.append(len(seen))
+    return curve
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("subject_dir", type=pathlib.Path)
+    ap.add_argument("--classify", nargs=2, metavar=("DELAYED", "PATCHED"),
+                    help="condition names to diff, e.g. --classify T1 T2")
+    args = ap.parse_args()
+
+    if not args.subject_dir.is_dir():
+        sys.exit(f"no such directory: {args.subject_dir}")
+
+    conditions = {}
+    for cond_dir in sorted(p for p in args.subject_dir.iterdir() if p.is_dir()):
+        loaded = load_condition(cond_dir)
+        if loaded:
+            conditions[loaded["name"]] = loaded
+
+    if not conditions:
+        sys.exit(f"no Results-TSV data found under {args.subject_dir}")
+
+    print(f"subject: {args.subject_dir.name}\n")
+    header = f"{'cond':<10}{'runs':>5}{'pairs':>7}{'scope':>7}{'instr':>7}" \
+             f"{'consid':>8}{'medMs':>9}{'fail%':>7}"
+    print(header)
+    print("-" * len(header))
+    for cond in conditions.values():
+        med = int(statistics.median(cond["times"])) if cond["times"] else -1
+        fail = f"{cond['fail_rate'] * 100:.0f}" if cond["fail_rate"] is not None else "-"
+        print(f"{cond['name']:<10}{cond['runs']:>5}{len(cond['union']):>7}"
+              f"{cond['scope_size']:>7}{cond['instrumented']:>7}"
+              f"{cond['considered']:>8}{med:>9}{fail:>7}")
+
+    print("\nsaturation (cumulative unique pairs per run)")
+    for cond in conditions.values():
+        print(f"  {cond['name']:<10}{saturation(cond['per_run'])}")
+
+    if args.classify:
+        delayed, patched = args.classify
+        missing = [c for c in (delayed, patched) if c not in conditions]
+        if missing:
+            sys.exit(f"missing condition(s): {', '.join(missing)}")
+        a = conditions[delayed]["union"]
+        b = conditions[patched]["union"]
+        eliminated, surviving = a - b, a & b
+
+        print(f"\nclassification: {delayed} vs {patched}")
+        print(f"  eliminated by patch ({delayed} \\ {patched}): {len(eliminated)}")
+        for pair in sorted(eliminated):
+            print(f"    - {pair}")
+        print(f"  surviving the patch ({delayed} & {patched}): {len(surviving)}")
+        for pair in sorted(surviving):
+            print(f"    ! {pair}")
+
+        if surviving and not eliminated:
+            verdict = "GENUINE_BUG (no pair removed by the barrier)"
+        elif eliminated and not surviving:
+            verdict = "REPAIRABLE (all pairs removed by the barrier)"
+        elif eliminated and surviving:
+            verdict = "MIXED (barrier removed some pairs, others persist)"
+        else:
+            verdict = "NO_SIGNAL (no pairs observed under delay)"
+        print(f"  verdict: {verdict}")
+
+
+if __name__ == "__main__":
+    main()
