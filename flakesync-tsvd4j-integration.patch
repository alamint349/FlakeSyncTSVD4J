diff --git a/flakesync-core/src/main/java/edu/utexas/ece/flakesync/agent/TsvScope.java b/flakesync-core/src/main/java/edu/utexas/ece/flakesync/agent/TsvScope.java
new file mode 100644
index 0000000..962be00
--- /dev/null
+++ b/flakesync-core/src/main/java/edu/utexas/ece/flakesync/agent/TsvScope.java
@@ -0,0 +1,137 @@
+package edu.utexas.ece.flakesync.agent;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Restricts TSVD4J instrumentation to the classes FlakeSync localized.
+ *
+ * <p>The scope file is passed via -DtsvScope and may be any of FlakeSync's
+ * location artifacts; the parser is deliberately permissive:
+ *   Locations_minimized.txt   ->  org/foo/Bar#42
+ *   CriticalPoints.csv        ->  testName,org.foo.Bar#42[800]
+ *   BarrierPoints.csv         ->  testName,org.foo.Bar#doWork#42
+ *   ResultMethods.txt         ->  org.foo.Bar#doWork
+ *
+ * <p>If -DtsvScope is absent the scope is unbounded, which reproduces stock
+ * whole-program TSVD4J behavior (condition C1 in the scaling study).
+ */
+public final class TsvScope {
+
+    private static volatile Set<String> scopeClasses = null;
+    private static final AtomicInteger INSTRUMENTED = new AtomicInteger(0);
+    private static final AtomicInteger CONSIDERED = new AtomicInteger(0);
+
+    private TsvScope() {
+    }
+
+    /** Returns true when className falls inside the FlakeSync-localized region. */
+    public static boolean inScope(String className) {
+        CONSIDERED.incrementAndGet();
+        Set<String> scope = scopeClasses;
+        if (scope == null) {
+            synchronized (TsvScope.class) {
+                if (scopeClasses == null) {
+                    scopeClasses = load(System.getProperty("tsvScope"));
+                }
+                scope = scopeClasses;
+            }
+        }
+        boolean hit = scope.isEmpty() || scope.contains(className);
+        if (hit) {
+            INSTRUMENTED.incrementAndGet();
+        }
+        return hit;
+    }
+
+    public static int getScopeSize() {
+        Set<String> scope = scopeClasses;
+        return scope == null ? -1 : scope.size();
+    }
+
+    public static int getInstrumentedCount() {
+        return INSTRUMENTED.get();
+    }
+
+    public static int getConsideredCount() {
+        return CONSIDERED.get();
+    }
+
+    private static Set<String> load(String path) {
+        Set<String> result = new HashSet<>();
+        if (path == null) {
+            // Unbounded scope: whole-program TSVD4J.
+            return Collections.unmodifiableSet(result);
+        }
+        File file = new File(path);
+        if (!file.exists()) {
+            System.err.println("[tsvd4j] scope file not found, falling back to whole program: " + path);
+            return Collections.unmodifiableSet(result);
+        }
+        BufferedReader reader = null;
+        try {
+            reader = new BufferedReader(new FileReader(file));
+            String line = reader.readLine();
+            while (line != null) {
+                String cls = parseClassName(line);
+                if (cls != null) {
+                    result.add(cls);
+                }
+                line = reader.readLine();
+            }
+        } catch (Exception ex) {
+            ex.printStackTrace();
+        } finally {
+            if (reader != null) {
+                try {
+                    reader.close();
+                } catch (Exception ignored) {
+                    // Nothing useful to do here.
+                }
+            }
+        }
+        if (result.isEmpty()) {
+            System.err.println("[tsvd4j] scope file yielded no classes: " + path);
+        }
+        return Collections.unmodifiableSet(result);
+    }
+
+    /** Extracts a dotted class name from one line of any FlakeSync location file. */
+    static String parseClassName(String rawLine) {
+        if (rawLine == null) {
+            return null;
+        }
+        String line = rawLine.trim();
+        if (line.isEmpty() || line.startsWith("#")) {
+            return null;
+        }
+        // The first line of Locations.txt is the bare delay value.
+        if (line.matches("\\d+")) {
+            return null;
+        }
+        // CSV rows are "<test>,<location>"; the location is the last field.
+        if (line.contains(",")) {
+            line = line.substring(line.lastIndexOf(',') + 1);
+        }
+        // Trailing "[delay]" annotation on critical points.
+        int bracket = line.indexOf('[');
+        if (bracket >= 0) {
+            line = line.substring(0, bracket);
+        }
+        // Barrier rows may be "<startLoc>-<endLoc>"; take the class of the first.
+        int dash = line.indexOf('-');
+        if (dash > 0 && line.indexOf('#') > dash) {
+            line = line.substring(0, dash);
+        }
+        String cls = line.split("#")[0].replaceAll("[/]", ".").trim();
+        if (cls.isEmpty()) {
+            return null;
+        }
+        return cls;
+    }
+}
