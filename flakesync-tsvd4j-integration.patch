+#!/usr/bin/env bash
+# Drives the TSV conditions for one test and files the results per condition.
+#
+# Usage:
+#   bash tools/run_study.sh <project_dir> <module> <Class#method> <subject_label> [runs]
+#
+# Assumes FlakeSync's concurrentfind / delaylocs / deltadebug / critsearch /
+# barrierpointsearch goals have already been run for this test.
+set -uo pipefail
+
+PROJ="${1:?project dir}"
+MODULE="${2:?module, e.g. common}"
+TEST="${3:?Class#method}"
+LABEL="${4:?subject label}"
+RUNS="${5:-10}"
+
+PLUGIN="edu.utexas.ece:flakesync-maven-plugin:1.0-SNAPSHOT"
+OUT_ROOT="$(pwd)/results/$LABEL"
+FS_DIR="$PROJ/.flakesync"
+TESTFILE="${TEST/#/.}"
+
+MIN_LOCS="$FS_DIR/${TESTFILE}-Locations_minimized.txt"
+METHODS="$FS_DIR/${TESTFILE}-ResultMethods.txt"
+
+stash() {   # stash <condition>
+  local cond="$1"
+  mkdir -p "$OUT_ROOT/$cond"
+  if [ -d "$FS_DIR/Results-TSV" ]; then
+    rm -rf "$OUT_ROOT/$cond/Results-TSV"
+    mv "$FS_DIR/Results-TSV" "$OUT_ROOT/$cond/Results-TSV"
+  else
+    echo "warn: no Results-TSV produced for $cond" >&2
+  fi
+}
+
+run() {     # run <condition> <extra mvn args...>
+  local cond="$1"; shift
+  echo "=== $LABEL / $cond ==="
+  rm -rf "$FS_DIR/Results-TSV"
+  ( cd "$PROJ" && mvn "$PLUGIN:tsvdetect" \
+      -Dflakesync.testName="$TEST" \
+      -Dflakesync.tsvRuns="$RUNS" \
+      -pl "$MODULE" "$@" ) || echo "warn: $cond exited non-zero" >&2
+  stash "$cond"
+}
+
+for required in "$MIN_LOCS"; do
+  [ -f "$required" ] || { echo "missing $required -- run deltadebug first" >&2; exit 1; }
+done
+
+# ---- RQ1: does the barrier repair eliminate the conflicting pair? -----------
+# T0: scoped, unpatched, no delay
+run T0 -Dflakesync.tsvScope="$MIN_LOCS"
+# T1: scoped, unpatched, FlakeSync delay injected at the localized locations
+run T1 -Dflakesync.tsvScope="$MIN_LOCS" \
+       -Dflakesync.tsvDelay=800 \
+       -Dflakesync.tsvDelayLocs="$MIN_LOCS"
+# T2: apply FlakeSync's patch, then re-run scoped with no delay
+echo ">>> apply the patches in $FS_DIR/patch now, then press enter"
+read -r _
+run T2 -Dflakesync.tsvScope="$MIN_LOCS"
+echo ">>> revert the patches now, then press enter"
+read -r _
+
+# ---- RQ2: what does scoping cost and save? ---------------------------------
+# C1: whole program
+run C1 -Dflakesync.tsvScope=NONE
+# C2: minimized locations (same as T0; copied for a self-contained table)
+run C2 -Dflakesync.tsvScope="$MIN_LOCS"
+# C3: coarse -- all concurrent methods
+if [ -f "$METHODS" ]; then
+  run C3 -Dflakesync.tsvScope="$METHODS"
+else
+  echo "skip C3: $METHODS not found" >&2
+fi
+
+echo
+python3 "$(dirname "$0")/aggregate_tsv.py" "$OUT_ROOT" --classify T1 T2
